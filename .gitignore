# The locally installed game and its proprietary assets are not part of this repo.
/MLBTS/
/Fastball.exe
/MLBTS-Setup.exe
/recomplauncher.json

# Downloaded toolchains and bundled Python runtime are reproducible local tools.
/llvm/
/python/
/bin/
/temp/
/logs/
__pycache__/
*.py[cod]

# Build outputs and compiled dependencies.
*.exe
*.dll
*.pyd
*.a
*.lib
*.obj
*.pdb

# Historical timeline snapshots are local backups, not dashboard source data.
/tools/data/progress_timeline_before_*.jsonl
/tools/progress_server*.log

# GitHub Pages data is regenerated by tools/export_progress_site.py.
/tools/progress_site/data/*.json
/tools/progress_server*.log
